# Copy to .env. Generate each secret independently. Do not commit .env.
# Hex passwords avoid special-character interpolation in Compose/DB URLs.
# openssl rand -hex 32 (for each password)
POSTGRES_PASSWORD=
ADMIN_USER=admin
ADMIN_PASSWORD=
MEDIAMTX_API_PASSWORD=
OBS_PASSWORD=
# openssl rand -base64 32 (back up this key along with PostgreSQL)
ENCRYPTION_KEY=

# For production put an HTTPS reverse proxy in front of localhost:8088.
PUBLIC_ORIGIN=https://stream.example.com
COOKIE_SECURE=true
DASHBOARD_BIND=127.0.0.1
DASHBOARD_PORT=8088
INGEST_BIND=0.0.0.0
DATA_PATH=/data
MEDIAMTX_API_URL=http://mediamtx:9997
MEDIAMTX_RTSP_URL=rtsp://mediamtx:8554/live
FILE_BROWSER_URL=http://192.168.1.7:8080

# Optional first-boot seeding. Later changes use the destination settings form.
YOUTUBE_STREAM_KEY=
YOUTUBE_RTMP_URL=rtmps://a.rtmp.youtube.com/live2
FACEBOOK_STREAM_KEY=
FACEBOOK_RTMP_URL=rtmps://live-api-s.facebook.com:443/rtmp
# JWT_SECRET is intentionally unused: this app uses revocable database sessions.
